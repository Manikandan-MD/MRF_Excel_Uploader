<mvc:View
    controllerName="mrpexceluploader.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:table="sap.ui.table">
 
    <m:Page title="Excel Upload Process">
 
        <m:content>
 
            <m:VBox width="100%">
 
                <!--  PANEL 1 — Excel Upload    -->
                <m:Panel
                    expandable="true"
                    expanded="true"
                    class="sapUiResponsiveMargin"
                    width="auto"
                    accessibleRole="Region">

                    <m:headerToolbar>
                        <m:OverflowToolbar>
                            <m:Title text="Excel Upload"/>
                        </m:OverflowToolbar>
                    </m:headerToolbar>
 
                    <m:VBox class="sapUiSmallMargin">
 
                        <u:FileUploader
                            id="fileUploader"
                            width="350px"
                            buttonText="Choose Excel"
                            fileType="xlsx,xls"
                            placeholder="Select .xlsx or .xls file..." />
 
                        <!-- Buttons Row -->
                        <m:HBox
                            class="sapUiMediumMarginTop"
                            justifyContent="SpaceBetween"
                            width="100%">

                            <m:Button
                                text="Send To Table"
                                type="Emphasized"
                                icon="sap-icon://upload-to-cloud"
                                press=".onSendToTable" />

                            <m:Button
                                text="Download Template"
                                type="Transparent"
                                icon="sap-icon://download"
                                press=".onDownloadTemplate" />

                        </m:HBox>
 
                    </m:VBox>
 
                </m:Panel>
 
                <!--  PANEL 2 — Line Item Table (14 cols + UniqueID)-->
                <m:Panel
                    expandable="true"
                    expanded="true"
                    class="sapUiResponsiveMargin"
                    width="auto"
                    accessibleRole="Region">

                    <m:headerToolbar>
                        <m:OverflowToolbar>
                            <m:Title text="{= 'Line Item Details (' + ${excelModel>/results}.length + ')' }"/>
                            <m:ToolbarSpacer/>
                            <m:Button text="Process" type="Accept" icon="sap-icon://process" press=".onProcess"/>
                        </m:OverflowToolbar>
                    </m:headerToolbar>
 
                    <table:Table
                        id="idLineItemTable"
                        rows="{excelModel>/results}"
                        selectionMode="None"
                        visibleRowCount="10"
                        alternateRowColors="true"
                        enableColumnReordering="true"
                        enableColumnFreeze="true"
                        columnHeaderHeight="40"
                        rowHeight="36">
 
                        <table:columns>
 
                            <!-- Unique ID — auto-generated per row -->
                            <!-- <table:Column width="100px">
                                <m:Label text="Unique ID"/>
                                <table:template>
                                    <m:Text text="{excelModel>UNIQUE_ID}"/>
                                </table:template>
                            </table:Column> -->
 
                            <table:Column width="150px">
                                <m:Label text="Material"/>
                                <table:template>
                                    <m:Text text="{excelModel>MATERIAL}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="100px">
                                <m:Label text="Plant"/>
                                <table:template>
                                    <m:Text text="{excelModel>PLANT}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="190px">
                                <m:Label text="Stock Category"/>
                                <table:template>
                                    <m:Text text="{excelModel>STOCK_CATEGORY}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="150px">
                                <m:Label text="WBS / Order"/>
                                <table:template>
                                    <m:Text text="{excelModel>WBS_ORDER}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="150px">
                                <m:Label text="Sheet Material"/>
                                <table:template>
                                    <m:Text text="{excelModel>SHEET_MATERIAL}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="130px">
                                <m:Label text="Metal Grade"/>
                                <table:template>
                                    <m:Text text="{excelModel>METAL_GRADE}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="140px">
                                <m:Label text="Sheet Thickness"/>
                                <table:template>
                                    <m:Text text="{excelModel>SHEET_THICKNESS}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="120px">
                                <m:Label text="RM Length"/>
                                <table:template>
                                    <m:Text text="{excelModel>RM_LENGTH}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="120px">
                                <m:Label text="RM Width"/>
                                <table:template>
                                    <m:Text text="{excelModel>RM_WIDTH}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="130px">
                                <m:Label text="Total RM Qty"/>
                                <table:template>
                                    <m:Text text="{excelModel>TOTAL_RM_QTY}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="80px">
                                <m:Label text="A"/>
                                <table:template>
                                    <m:Text text="{excelModel>A}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="80px">
                                <m:Label text="B"/>
                                <table:template>
                                    <m:Text text="{excelModel>B}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="80px">
                                <m:Label text="C"/>
                                <table:template>
                                    <m:Text text="{excelModel>C}"/>
                                </table:template>
                            </table:Column>
 
                            <table:Column width="80px">
                                <m:Label text="D"/>
                                <table:template>
                                    <m:Text text="{excelModel>D}"/>
                                </table:template>
                            </table:Column>
 
                        </table:columns>
 
                    </table:Table>
 
                    <m:HBox
                        width="100%"
                        fitContainer="true"
                        justifyContent="End"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom">
 
                        <!-- <m:Button
                            text="Process"
                            type="Accept"
                            icon="sap-icon://process"
                            press=".onProcess"/> -->
 
                    </m:HBox>
 
                </m:Panel>
 
            </m:VBox>
 
        </m:content>
 
    </m:Page>
 
</mvc:View>
